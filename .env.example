# Copy this file to .env and fill in the values before running.
# Never commit .env to version control.

# Groq API key (required for LLM inference — get one at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Qdrant vector database
# Option A — local disk (no Docker needed, default for dev):
#   Leave QDRANT_URL pointing at localhost. If Qdrant is unreachable,
#   the app automatically falls back to local disk at QDRANT_PATH.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                          # leave empty for local Qdrant
QDRANT_PATH=qdrant_db                    # relative to project root (auto-resolved)

# JWT secret — change this to a long random string in any non-demo environment
SECRET_KEY=medibot-secret-key-change-in-production

# Path to SQLite database (default: db/mediassist.db relative to project root)
DATABASE_PATH=

# LLM model override (default: llama3-70b-8192)
# Other fast Groq options: llama3-8b-8192, llama-3.1-70b-versatile, mixtral-8x7b-32768
LLM_MODEL=
