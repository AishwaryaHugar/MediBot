# Copy this file to .env and fill in the values before running.
# Never commit .env to version control.

# Anthropic Claude API key (required for LLM inference)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Qdrant vector database
# Option A — local disk (no Docker needed, default for dev):
#   Leave QDRANT_URL pointing at localhost. If Qdrant is unreachable,
#   the app automatically falls back to local disk at QDRANT_PATH.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                          # leave empty for local Qdrant
QDRANT_PATH=./qdrant_db                  # local disk fallback path

# JWT secret — change this to a long random string in any non-demo environment
SECRET_KEY=medibot-secret-key-change-in-production

# Path to SQLite database (default: db/mediassist.db relative to project root)
DATABASE_PATH=

# LLM model override (default: claude-sonnet-5)
LLM_MODEL=
